# Kopieer dit bestand naar .env.local en vul je eigen Supabase-gegevens in.
# Te vinden in je Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-public-key

# Optioneel: rechtstreeks prijzen synchroniseren naar WooCommerce (WooCommerce > Instellingen > Geavanceerd > REST API, lezen/schrijven)
# Nooit met NEXT_PUBLIC_ beginnen -- deze sleutels mogen de browser niet bereiken.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
